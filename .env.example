# Copy to .env.local and fill in. Never commit real values.
# Env vars are read at build time for prerendered pages: rebuild/redeploy after changing them.

# Public site URL (no trailing slash). Enables canonical, hreflang, Open Graph URLs and the sitemap.
# Example: https://www.example.com
SITE_URL=

# --- Contact form delivery (Resend) ---------------------------------------
# If any of the three required values below is empty, submissions are NOT sent:
# visitors are told the online form is temporarily unavailable and are shown the phone number.

# API key from https://resend.com/api-keys (sending access only is enough).
RESEND_API_KEY=

# Sender. Must belong to a domain verified in Resend.
# Example: Website <no-reply@your-domain.com>
CONTACT_FROM_EMAIL=

# Inbox(es) that receive the requests. Comma-separated for several.
CONTACT_TO_EMAIL=

# Optional: "true" sends an automatic confirmation to the visitor in their language.
CONTACT_SEND_ACKNOWLEDGEMENT=false
